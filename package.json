{
    "name": "bitsocial-spam-blocker",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "resolutions": {
        "@conventional-changelog/git-client@npm:^1.0.0": "npm:2.7.0",
        "@libp2p/gossipsub": "16.0.4",
        "@libp2p/kad-dht@npm:^16.2.0": "npm:16.2.6",
        "@protobufjs/utf8@npm:^1.1.0": "npm:1.1.1",
        "axios@npm:^1.7.2": "npm:1.18.1",
        "basic-ftp@npm:^5.0.2": "npm:5.3.1",
        "brace-expansion@npm:^1.1.7": "npm:1.1.16",
        "brace-expansion@npm:^5.0.5": "npm:5.0.8",
        "esbuild@npm:^0.27.0": "npm:0.28.1",
        "fast-uri@npm:^3.0.1": "npm:3.1.4",
        "follow-redirects@npm:^1.15.11": "npm:1.16.0",
        "form-data@npm:^4.0.5": "npm:4.0.6",
        "ip-address@npm:^10.0.1": "npm:10.1.1",
        "js-yaml@npm:^4.1.0": "npm:4.3.0",
        "lodash@npm:4.17.21": "npm:4.18.1",
        "postcss@npm:^8.5.6": "npm:8.5.23",
        "protobufjs@npm:^6.10.2": "npm:7.6.5",
        "tar@npm:^7.5.4": "npm:7.5.22",
        "tmp@npm:^0.0.33": "npm:0.2.7",
        "undici@npm:6.22.0": "npm:6.27.0",
        "undici@npm:^7.16.0": "npm:7.28.0",
        "undici@npm:^7.19.0": "npm:7.28.0",
        "undici@npm:^8.0.3": "npm:8.5.0",
        "uuid@npm:^11.0.0": "npm:11.1.1",
        "uuid@npm:13.0.0": "npm:13.0.1",
        "ws@npm:^8.5.0": "npm:8.21.0",
        "ws@npm:^8.18.3": "npm:8.21.0"
    },
    "packageManager": "yarn@4.17.1",
    "engines": {
        "node": ">=22"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "yarn workspace @bitsocial/spam-blocker-shared build && yarn workspace @bitsocial/spam-blocker-challenge build",
        "llms:generate": "node scripts/generate-llms-files.mjs",
        "test": "yarn workspace @bitsocial/spam-blocker-challenge test",
        "type-check": "yarn workspace @bitsocial/spam-blocker-shared type-check && yarn workspace @bitsocial/spam-blocker-challenge type-check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky",
        "commit": "cz",
        "release:challenge": "cd packages/challenge && HUSKY=0 release-it --config .release-it.json"
    },
    "devDependencies": {
        "@commitlint/cli": "20.2.0",
        "@commitlint/config-conventional": "20.3.1",
        "@pkcprotocol/pkc-js": "0.0.30",
        "@release-it/conventional-changelog": "10.0.1",
        "commitizen": "4.2.5",
        "cz-conventional-changelog": "3.3.0",
        "husky": "9.1.7",
        "prettier": "3.8.1",
        "release-it": "19.2.3",
        "typescript": "7.0.2"
    },
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    },
    "overrides": {
        "@pkcprotocol/pkc-js": "$@pkcprotocol/pkc-js",
        "@mintpass/challenge": "npm:empty-npm-package@1.0.0",
        "skia-canvas": "npm:empty-npm-package@1.0.0"
    }
}
